# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release signing (see README.md "Release signing" section)
android/key.properties
android/app/*.jks
android/app/*.keystore

# Real Firebase config — replace the checked-in placeholders yourself via
# `flutterfire configure`; keep your own copies out of version control if the
# repo is public.
lib/firebase_options_local.dart

# Firebase Functions
functions/node_modules/
functions/lib/
functions/.env
functions/.runtimeconfig.json

# Local Firebase emulator state (see README.md "Local development with the
# Firebase emulators") — throwaway dev data, never real user data.
.emulator-data/
firestore-debug.log
ui-debug.log
storage-debug.log
firebase-debug.log
scripts/node_modules/

# Book cover images you drop in for scripts/add-books.mjs — the images
# themselves shouldn't bloat the repo; manifest.json (metadata) is fine to
# keep, so it's not ignored here.
firebase-legacy/scripts/book-covers-inbox/*.jpg
firebase-legacy/scripts/book-covers-inbox/*.jpeg
firebase-legacy/scripts/book-covers-inbox/*.png
firebase-legacy/scripts/book-covers-inbox/*.webp

# Firebase Admin SDK service account key(s) from the retired Firebase setup
# (now under firebase-legacy/) — full admin access; must never be committed.
**/*firebase-adminsdk*.json
**/*service-account*.json

# Supabase CLI local state (if you use `supabase link` / `supabase start`).
supabase/.temp/
supabase/.branches/
