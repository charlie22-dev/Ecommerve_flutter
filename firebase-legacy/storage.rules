rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Book cover images: public read, any signed-in user can write.
    // Storage rules can't read Firestore, so they can't check the same
    // `isAdmin` flag firestore.rules does — the real integrity boundary is
    // that only an admin can ever create/update a `books` document
    // pointing at an uploaded file (see firestore.rules), so a stray
    // upload from a non-admin is just an orphaned, unreferenced file, not
    // a data-integrity issue.
    match /book-covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Avatars: public read, only the owning user may write their own file.
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && fileName.matches(request.auth.uid + '\\..*');
    }

    // Review photos: public read, any signed-in user can write (same
    // integrity note as book-covers above — the real boundary is that a
    // review Firestore doc can only ever be created by its own author).
    match /review-photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
